local antiSitEnabled = false
local seatConnections = {}
local charConnections = {}

local function neutralizeSeat(seat)
    if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
        pcall(function()
            seat.Disabled = true
            seat.CanTouch = false
        end)
    end
end

local function restoreSeat(seat)
    if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
        pcall(function()
            seat.Disabled = false
            seat.CanTouch = true
        end)
    end
end

local function applyToCharacter(character)
    for _, c in pairs(charConnections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(charConnections)
    
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end
    
    pcall(function()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
    end)
    
    table.insert(charConnections, humanoid.StateChanged:Connect(function(_, newState)
        if antiSitEnabled and newState == Enum.HumanoidStateType.Seated then
            pcall(function()
                humanoid.Sit = false
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
        end
    end))
    
    table.insert(charConnections, RunService.Heartbeat:Connect(function()
        if not antiSitEnabled then return end
        if humanoid.Sit then
            pcall(function() humanoid.Sit = false end)
        end
        local root = character:FindFirstChild("HumanoidRootPart")
        if root then
            for _, obj in pairs(root:GetChildren()) do
                if obj:IsA("Weld") or obj:IsA("WeldConstraint") then
                    if obj.Name == "SeatWeld" or obj.Name == "VehicleSeat" then
                        pcall(function() obj:Destroy() end)
                    end
                end
            end
        end
    end))
end

local function enableAntiSit()
    antiSitEnabled = true
    for _, obj in ipairs(Workspace:GetDescendants()) do
        neutralizeSeat(obj)
    end
    table.insert(seatConnections, Workspace.DescendantAdded:Connect(function(obj)
        if antiSitEnabled then
            task.wait(0.1)
            neutralizeSeat(obj)
        end
    end))
    if LP.Character then
        applyToCharacter(LP.Character)
    end
end

local function disableAntiSit()
    antiSitEnabled = false
    for _, c in pairs(seatConnections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(seatConnections)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        restoreSeat(obj)
    end
end

LP.CharacterAdded:Connect(function(char)
    if antiSitEnabled then
        applyToCharacter(char)
    end
end)

