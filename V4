-- ═══ PREMIUM DETECT ═══
local PD = false
local Labels = {}

local function makeLabel(p)
    if Labels[p.UserId] then return end
    local char = p.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    local isP = p.MembershipType == Enum.MembershipType.Premium
    local origColors = {}

    if isP then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                origColors[part] = {Color = part.Color, Material = part.Material}
                part.Color = Color3.fromRGB(255, 215, 0)
                part.Material = Enum.Material.Neon
            end
        end
    end

    local BB = Instance.new("BillboardGui", head)
    BB.Size = UDim2.new(0, 160, 0, 36)
    BB.StudsOffset = Vector3.new(0, 2.3, 0)
    BB.AlwaysOnTop = true

    local bg = Instance.new("Frame", BB)
    bg.Size = UDim2.new(0, 120, 0, 26)
    bg.Position = UDim2.new(0.5, -60, 0.5, -13)
    bg.BackgroundColor3 = isP and Color3.fromRGB(45, 35, 5) or Color3.fromRGB(30, 30, 40)
    bg.BorderSizePixel = 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 8)

    local bgs = Instance.new("UIStroke", bg)
    bgs.Color = isP and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(150, 150, 170)
    bgs.Thickness = 2

    local lbl = Instance.new("TextLabel", bg)
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = isP and "💎 PREMIUM" or "👤 NORMAL"
    lbl.TextColor3 = isP and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(255, 255, 255)
    lbl.TextSize = 12
    lbl.Font = Enum.Font.GothamBold

    Labels[p.UserId] = {BB = BB, Colors = origColors, IsP = isP, Player = p}
end

local function removeLbl(p)
    if Labels[p.UserId] then
        local d = Labels[p.UserId]
        if d.IsP then
            for part, orig in pairs(d.Colors) do
                pcall(function()
                    if part and part.Parent then
                        part.Color = orig.Color
                        part.Material = orig.Material
                    end
                end)
            end
        end
        pcall(function() d.BB:Destroy() end)
        Labels[p.UserId] = nil
    end
end

local function removeAll()
    for _, d in pairs(Labels) do
        if d.IsP then
            for part, orig in pairs(d.Colors) do
                pcall(function()
                    if part and part.Parent then
                        part.Color = orig.Color
                        part.Material = orig.Material
                    end
                end)
            end
        end
        pcall(function() d.BB:Destroy() end)
    end
    Labels = {}
end

local function applyAll()
    if not PD then return end
    
    for userId, d in pairs(Labels) do
        if d.IsP then
            for part, orig in pairs(d.Colors) do
                pcall(function()
                    if part and part.Parent then
                        part.Color = orig.Color
                        part.Material = orig.Material
                    end
                end)
            end
        end
        pcall(function() d.BB:Destroy() end)
    end
    Labels = {}
    
    task.wait(0.1)
    for _, p in pairs(Players:GetPlayers()) do
        makeLabel(p)
    end
end

task.spawn(function()
    while true do
        task.wait(10)
        if PD then
            applyAll()
        end
    end
end)

Players.PlayerAdded:Connect(function(p)
