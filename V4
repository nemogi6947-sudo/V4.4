local function doHop()
    local ok, resp = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?limit=100")
    end)
    if not ok then notify("Server list fail", Color3.fromRGB(255,80,80)) return end
    local data = HS:JSONDecode(resp)
    local list = {}
    for _, s in pairs(data.data) do
        if s.playing < s.maxPlayers and s.id ~= game.JobId then
            table.insert(list, s.id)
        end
    end
    if #list == 0 then notify("No server", Color3.fromRGB(255,80,80)) return end
    local pick = list[math.random(1,#list)]
    pcall(function() writefile("hop_flag.txt", "active") end)
    pcall(function() writefile("hop_cont.lua", CONT) end)
    if queue_on_teleport then
        queue_on_teleport([[loadstring(readfile("hop_cont.lua"))()]])
    elseif queueonteleport then
        queueonteleport([[loadstring(readfile("hop_cont.lua"))()]])
    end
    notify("Hopping...", Color3.fromRGB(100,150,255))
    task.wait(1)
    TPS:TeleportToPlaceInstance(game.PlaceId, pick, LP)
end

