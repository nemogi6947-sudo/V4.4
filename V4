local function stopTween()
    Tweening = false
    TargetPlayer = nil
    
    if NoclipConn then
        NoclipConn:Disconnect()
        NoclipConn = nil
    end
    
    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end
        
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

local function flyToPlayer(target)
    if Tweening then stopTween() end
    Tweening = true
    TargetPlayer = target
    
    local char = LP.Character
    if not char then 
        Tweening = false
        return 
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then 
        Tweening = false
        return 
    end
    
    notify("Flying to " .. target.Name .. "...", Color3.fromRGB(255, 215, 0))
    
    NoclipConn = RunService.Stepped:Connect(function()
        if char and char.Parent then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
    
    hum.PlatformStand = true
    
    task.spawn(function()
        while Tweening and TargetPlayer do
            if not hrp or not hrp.Parent then break end
            if not TargetPlayer.Character then break end
            
            local tHrp = TargetPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not tHrp then break end
            
            local myPos = hrp.CFrame.Position
            local targetPos = tHrp.CFrame.Position
            local dist = (targetPos - myPos).Magnitude
            
            if dist < 4 then break end
            
            local speed = dist / TweenSpeed
            local dir = (targetPos - myPos).Unit
            local moveAmount = speed * 0.03
            moveAmount = math.clamp(moveAmount, 1, dist)
            
            local newPos = myPos + (dir * moveAmount)
            
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {char, TargetPlayer.Character}
            
            local rayResult = workspace:Raycast(newPos + Vector3.new(0, 5, 0), Vector3.new(0, -20, 0), rayParams)
            if rayResult then
                local groundY = rayResult.Position.Y + 3
                if newPos.Y < groundY then
                    newPos = Vector3.new(newPos.X, groundY, newPos.Z)
                end
            end
            
            pcall(function()
                hrp.CFrame = CFrame.new(newPos, Vector3.new(targetPos.X, newPos.Y, targetPos.Z))
            end)
            
            task.wait()
        end
        
        if NoclipConn then
            NoclipConn:Disconnect()
            NoclipConn = nil
        end
        
        if hrp and hrp.Parent then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {char}
            
            local rayResult = workspace:Raycast(hrp.Position + Vector3.new(0, 5, 0), Vector3.new(0, -50, 0), rayParams)
            if rayResult then
                local groundY = rayResult.Position.Y + 3
                pcall(function()
                    hrp.CFrame = CFrame.new(hrp.Position.X, groundY, hrp.Position.Z)
                end)
            end
        end
        
        if hum and hum.Parent then
            hum.PlatformStand = false
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end
        
        Tweening = false
        notify("Reached!", Color3.fromRGB(6, 255, 165))
    end)
end

