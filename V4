local ALERT_RANGE = 50
local AlertedPlayers = {}

task.spawn(function()
    while true do
        task.wait(2)
        
        local myChar = LP.Character
        if not myChar then
            task.wait(1)
            continue
        end
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then
            task.wait(1)
            continue
        end
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.MembershipType == Enum.MembershipType.Premium then
                local pChar = p.Character
                if pChar then
                    local pHrp = pChar:FindFirstChild("HumanoidRootPart")
                    if pHrp then
                        local dist = (pHrp.Position - myHrp.Position).Magnitude
                        
                        if dist <= ALERT_RANGE then
                            if not AlertedPlayers[p.UserId] then
                                AlertedPlayers[p.UserId] = true
                                notify("💎 Premium Nearby: " .. p.Name .. " (" .. math.floor(dist) .. " studs)", Color3.fromRGB(255,215,0))
                            end
                        else
                            if AlertedPlayers[p.UserId] then
                                AlertedPlayers[p.UserId] = nil
                            end
                        end
                    end
                end
            end
        end
    end
end)

